{
  "$schema": "https://vercel.com/static/schema.json",
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false
}
